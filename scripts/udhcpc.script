#!/bin/sh
# /usr/share/udhcpc/default.script — applied by busybox udhcpc on lease
# events. QEMU's user networking (slirp) always uses a /24.
case "$1" in
  deconfig)
    ip addr flush dev "$interface" 2>/dev/null
    ;;
  bound|renew)
    ip addr flush dev "$interface" 2>/dev/null
    ip addr add "$ip/24" dev "$interface"
    for r in $router; do
      ip route add default via "$r" 2>/dev/null && break
    done
    : > /etc/resolv.conf
    for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
    ;;
esac
exit 0
