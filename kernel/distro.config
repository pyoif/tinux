# kernel/distro.config — merged AFTER virt-tiny.config.
#
# Layer that makes the kernel able to boot REAL distro root filesystems,
# not just our busybox appliance.
#
#   Alpine (busybox/openrc/musl)  -> boots WITHOUT this file already.
#   Debian (systemd/glibc)        -> needs this file: the tinyconfig base
#                                    (allnoconfig) switches off CGROUPS,
#                                    SYSVIPC, INOTIFY_USER, SIGNALFD,
#                                    TIMERFD, EVENTFD, FHANDLE, SECCOMP...
#                                    which systemd requires.
#
# systemd's own required list (README, "Kernel config options"):
# DEVTMPFS, CGROUPS, INOTIFY_USER, SIGNALFD, TIMERFD, EPOLL, UNIX, SYSFS,
# PROC_FS, FHANDLE, FANOTIFY, SHMEM, TMPFS (+ NET_NS/USER_NS for nspawn).
# This fragment covers all of them plus the cheap "recommended" ones.
#
# Cost: roughly +1 MB to the gzip'd Image. CI builds this as the `distro`
# variant (and `containers` on top of it) — see the matrix in
# .github/workflows/kernel.yml.

# ---- systemd requirements ----
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_FHANDLE=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_SYSVIPC=y
CONFIG_PROC_SYSCTL=y
CONFIG_IPV6=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# systemd hard-requires this to stay OFF:
# CONFIG_SYSFS_DEPRECATED is not set

# ---- systemd recommended (all small) ----
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KCMP=y
CONFIG_PSI=y
CONFIG_KEYS=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y

# ---- classic glibc/distro userspace expectations ----
CONFIG_POSIX_MQUEUE=y
CONFIG_AIO=y
CONFIG_RSEQ=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y

# ---- virtio bits real distros use ----
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y

# ---- filesystems common in distro media / host shares ----
# MISC_FILESYSTEMS is the menu gate for squashfs (fs/Kconfig: squashfs
# is sourced inside `if MISC_FILESYSTEMS`) — without it, SQUASHFS=y is
# silently discarded, not even a "not set" line.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- extra initramfs compressors (Debian initrds are zstd) ----
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y

# NOT included (would each add real weight): BPF family, netfilter,
# bridge/veth (docker/podman), btrfs/xfs/f2fs, sound, USB, 32-bit arm
# compat (CONFIG_COMPAT). Ask and they can be layered on the same way.