# kernel/containers.config — merged AFTER virt-tiny.config and distro.config.
#
# THE container layer: BPF + netfilter + bridge/veth + the cgroup
# controllers the runtimes need. With this (and the two layers below it),
# docker/podman can run INSIDE the guest.
#
# Verified against real linux-6.12.y by scripts/check-fragment.sh in CI.
#
# Costs roughly +1 MB gzip'd Image and ~+2 MB permanently-resident kernel
# text (kernel pages are never balloon-reported, but 2 MB is noise).
#
# Honest performance note: on an unrooted phone QEMU runs in TCG mode
# (software emulation, no KVM) — containers WORK, but CPU-heavy workloads
# are slow. Give the guest -m 1G when running a container runtime.
#
# To disable: remove the `containers` entry from the matrix in
# .github/workflows/kernel.yml.

# ---- BPF: on cgroup v2 the devices controller IS a BPF program ----
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y

# ---- cgroup controllers the runtimes use (beyond distro.config) ----
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y

# ---- container networking ----
# veth pairs connect the container netns to docker0; br_netfilter makes
# the host's iptables rules see bridged traffic.
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# ---- netfilter core ----
# NETFILTER_ADVANCED is a hidden gate: XT_MATCH_COMMENT and friends are
# invisible without it (same trap as NETDEVICES for VIRTIO_NET).
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y

# ---- nftables backend (docker uses iptables-nft these days) ----
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y

# ---- the matches/targets docker actually inserts ----
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# ---- legacy iptables compat (classic iptables binaries) ----
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# NOT included: VXLAN/IPVLAN (docker swarm overlay networks only),
# IP_VS, net_cls/net_prio cgroups (legacy), MEMCG_SWAP (no swap in the
# guest anyway), CGROUP_HUGETLB (needs HUGETLB_PAGE, only for pinned-
# hugepage workloads). Add on the same pattern if ever needed.