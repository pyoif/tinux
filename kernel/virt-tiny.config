# kernel/virt-tiny.config — merged on top of `make ARCH=arm64 tinyconfig`
#
# Target: qemu-system-aarch64 -M virt (virtio over MMIO — no PCI needed)
# Result: a ~2–3 MB kernel that boots to a busybox shell on the serial
# console, with virtio-blk/net/9p, ext4, gzip initramfs support and
# virtio-balloon + free page reporting (host RSS shrinks automatically
# when the guest frees memory).
#
# Every line here is enforced by scripts/check-fragment.sh: if
# olddefconfig silently drops an option (unmet dependency), CI fails
# instead of shipping a kernel that doesn't boot.

# ---- basics ----
CONFIG_NR_CPUS=4
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_EPOLL=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- hidden symbols that arm64 selects anyway; listed so check-fragment
#      FAILS loudly if a future kernel stops providing them (the machine
#      wouldn't boot without them) ----
CONFIG_ARM_AMBA=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_PSCI_FW=y

# ---- virtio (VIRTIO itself is a hidden symbol selected by VIRTIO_MMIO) ----
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y

# ---- networking ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# ---- filesystems for an optional persistent rootfs / host share ----
CONFIG_EXT4_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# ---- automatic host-memory reclaim ----
# The balloon reports guest-free pages to QEMU, which madvise()s them
# away — the host (Android) RSS shrinks by itself. VIRTIO_BALLOON also
# selects PAGE_REPORTING; listed explicitly so it can never be lost.
CONFIG_PAGE_REPORTING=y
# Poisoning must stay OFF: QEMU skips reported pages when the guest
# poisons them, which would silently disable the whole reclaim.
# CONFIG_PAGE_POISONING is not set
