# kernel/virt-tiny.config — merged on top of `make ARCH=arm64 tinyconfig`
#
# Every '=y' line is verified against the final .config by
# scripts/check-fragment.sh, so an option silently dropped because of a
# missing dependency fails the build instead of producing a broken kernel.

# ---- platform plumbing for QEMU's '-M virt' (arm64) ----
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_AMBA=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# ---- serial console: PL011 = ttyAMA0 (routed to your terminal via -nographic) ----
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ---- userspace basics that tinyconfig strips ----
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_EPOLL=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- block layer + initramfs (busybox rootfs passed via -initrd) ----
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ---- compressed kernel image (arm64's Image.gz target needs no Kconfig) ----
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# ---- virtio, MMIO transport (what '-M virt' uses; no PCI needed) ----
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# ---- filesystems ----
CONFIG_EXT4_FS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y

# ---- networking (QEMU user-mode NAT) ----
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# ---- 9p host folder share (mounted at /mnt/host in the guest) ----
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# ---- automatic memory reclaim ----
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y

# NOTE: do NOT enable CONFIG_PAGE_POISONING — QEMU skips free-page-reporting
# hints when the guest poisons freed pages.
